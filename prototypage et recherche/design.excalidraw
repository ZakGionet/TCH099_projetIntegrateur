      "link": null,
      "locked": false,
      "text": "\nCREATE VIEW VIEW_Assignment_Steps (\n    SELECT *\n        s.startDateTime, s.endDateTime, s.name, s.status\n    FROM VIEW_User_Assignements a\n    INNER JOIN Steps s\n        ON a.assignmentId = s.assignmentId\n)\n\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nCREATE VIEW VIEW_Assignment_Steps (\n    SELECT *\n        s.startDateTime, s.endDateTime, s.name, s.status\n    FROM VIEW_User_Assignements a\n    INNER JOIN Steps s\n        ON a.assignmentId = s.assignmentId\n)\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
