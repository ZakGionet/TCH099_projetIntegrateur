      "updated": 1771980610763,
      "link": null,
      "locked": false,
      "text": "CREATE VIEW VIEW_Assignments AS (\n    SELECT\n        assignmentId, name, dueDateTime\n    FROM User_Courses_For_Semester cs\n    INNER JOIN Assignments a\n        ON cs.courseId = a.courseId\n)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CREATE VIEW VIEW_Assignments AS (\n    SELECT\n        assignmentId, name, dueDateTime\n    FROM User_Courses_For_Semester cs\n    INNER JOIN Assignments a\n        ON cs.courseId = a.courseId\n)",
      "autoResize": true,
      "lineHeight": 1.25
    },
