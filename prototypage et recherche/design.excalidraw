      "updated": 1771979538772,
      "link": null,
      "locked": false,
      "text": "CREATE VIEW User_Courses_For_Semester AS (\n    SELECT * \n    FROM Users\n    INNER JOIN Semesters\n        ON Users.userId = Semesters.userId\n    INNER JOIN Courses \n        ON Semesters.semesterId = Courses.semesterId\n    WHERE Users.id = <UserId>\n)\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CREATE VIEW User_Courses_For_Semester AS (\n    SELECT * \n    FROM Users\n    INNER JOIN Semesters\n        ON Users.userId = Semesters.userId\n    INNER JOIN Courses \n        ON Semesters.semesterId = Courses.semesterId\n    WHERE Users.id = <UserId>\n)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
